{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yerminal",
  "version": "0.1.0",
  "identifier": "dev.yerminal.workspace",
  "build": {
    "beforeDevCommand": "npm run frontend:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "yerminal",
        "width": 1440,
        "height": 900,
        "minWidth": 920,
        "minHeight": 600,
        "backgroundColor": "#101114"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
